# Copy to .env and adjust if needed. Defaults match the proof notebook.
# With docker compose, the three path settings (CHROMA_DIR, UPLOAD_DIR, JOBS_DB) are fixed by
# docker-compose.yml so data stays on its volume; everything else here is used as-is.
EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2
GEN_MODEL=Qwen/Qwen2.5-1.5B-Instruct
CHROMA_DIR=chroma_db
COLLECTION=docs
CHUNK_SIZE=800
CHUNK_OVERLAP=150
TOP_K=3
MAX_NEW_TOKENS=200
LOG_LEVEL=INFO

# API
UPLOAD_DIR=uploads
JOBS_DB=jobs.sqlite3
MAX_UPLOAD_MB=20
